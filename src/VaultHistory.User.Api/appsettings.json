{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Hashing": {
    "MemorySize": 65536,
    "DegreeOfParallelism": 8,
    "Iterations": 4,
    "SaltSize": 16,
    "HashSize": 32
  },
  "Password": {
    "MinLength": 8,
    "Regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,}$"
  },
  "Jwt": {
    "PrivateKey": "YourSuperSecretKey",
    "Issuer": "VaultHistory.User.Api",
    "Audience": "VaultHistory.User.Clients",
    "ExpirationMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}